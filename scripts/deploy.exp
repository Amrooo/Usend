#!/usr/bin/expect -f
set timeout 120

proc run_rsync {src dst} {
    spawn rsync -avz --inplace -e "ssh -o StrictHostKeyChecking=no" $src $dst
    expect {
        -nocase "password:" {
            send "rW9MJAfvXn4n\r"
            exp_continue
        }
        eof
    }
}

puts "=== Syncing dist/ ==="
run_rsync "dist/" "master_awqbxuyqcq@134.209.28.27:/home/1150801.cloudwaysapps.com/mksqztfeks/public_html/"


puts "=== Syncing functions/server.cjs ==="
run_rsync "functions/server.cjs" "master_awqbxuyqcq@134.209.28.27:/home/1150801.cloudwaysapps.com/mksqztfeks/public_html/functions/server.cjs"

puts "=== Syncing api.php ==="
run_rsync "api.php" "master_awqbxuyqcq@134.209.28.27:/home/1150801.cloudwaysapps.com/mksqztfeks/public_html/api.php"

puts "=== Syncing .htaccess ==="
run_rsync ".htaccess" "master_awqbxuyqcq@134.209.28.27:/home/1150801.cloudwaysapps.com/mksqztfeks/public_html/.htaccess"

puts "=== Syncing api/ ==="
run_rsync "api/" "master_awqbxuyqcq@134.209.28.27:/home/1150801.cloudwaysapps.com/mksqztfeks/public_html/api/"

puts "=== Deployment Sync Completed! ==="
