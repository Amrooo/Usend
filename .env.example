ARAMEX_ACCOUNT_ENTITY="DXB"
ARAMEX_ACCOUNT_COUNTRY_CODE="AE"
ARAMEX_SOURCE=0
ARAMEX_VERSION="v1.0"

# GitHub Personal Access Token
