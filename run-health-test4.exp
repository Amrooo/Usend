#!/usr/bin/expect -f
set timeout 30

spawn ssh -o StrictHostKeyChecking=no master_awqbxuyqcq@134.209.28.27 "curl -s -X POST -H 'Content-Type: application/json' http://127.0.0.1:3005/api/courier/rate -d '{\"courierId\":\"aramex\",\"payload\":{\"originCity\":\"Dubai\",\"originCountry\":\"AE\",\"destCity\":\"Abu Dhabi\",\"destCountry\":\"AE\",\"weightKb\":1,\"isExpress\":false},\"environment\":\"production\"}'"
expect {
    -nocase "password:" {
        send "rW9MJAfvXn4n\r"
        exp_continue
    }
    eof
}

spawn ssh -o StrictHostKeyChecking=no master_awqbxuyqcq@134.209.28.27 "curl -s -X POST -H 'Content-Type: application/json' http://127.0.0.1:3005/api/courier/rate -d '{\"courierId\":\"noon\",\"payload\":{\"originCity\":\"Dubai\",\"originCountry\":\"AE\",\"destCity\":\"Abu Dhabi\",\"destCountry\":\"AE\",\"weightKb\":1,\"isExpress\":false},\"environment\":\"production\"}'"
expect {
    -nocase "password:" {
        send "rW9MJAfvXn4n\r"
        exp_continue
    }
    eof
}
